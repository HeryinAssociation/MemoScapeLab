# Copy to .dev.vars for local overrides. Never commit real production secrets.
PASSWORD_PEPPER=replace-with-a-long-random-secret
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@memoscapelab.local
SUPERADMIN_PASSWORD=replace-with-a-strong-unique-password

# Transactional email: Tencent Cloud SES. Copy this file to .dev.vars and fill
# secrets locally. The committed example must never contain real credentials.
EMAIL_PROVIDER=tencent-ses
TENCENTCLOUD_SECRET_ID=replace_with_a_new_secret_id
TENCENTCLOUD_SECRET_KEY=replace_with_a_new_secret_key
TENCENT_SES_REGION=ap-guangzhou
TENCENT_SES_FROM=MemoscapeLab <verify@mail.metaconstr.net>
TENCENT_SES_TEMPLATE_ID=replace_with_an_approved_template_id
# Optional self-hosted-only endpoint. Leave unset for direct Tencent SES access.
# TENCENT_SES_ENDPOINT=http://ses-proxy:8788/

# Project image and avatar storage: Tencent LighthouseCOS. Keep these credentials separate from
# the SES sender credentials and grant only the two buckets below.
TENCENT_LIGHTCOS_ACCOUNT_ID=100020696386
TENCENT_LIGHTCOS_APP_ID=1306930939
TENCENT_LIGHTCOS_REGION=ap-shanghai
TENCENT_LIGHTCOS_ARCHIVE_BUCKET=memoscape-archive-1306930939
TENCENT_LIGHTCOS_MEDIA_BUCKET=memoscape-media-1306930939
TENCENT_LIGHTCOS_SECRET_ID=replace_with_a_dedicated_cos_secret_id
TENCENT_LIGHTCOS_SECRET_KEY=replace_with_a_dedicated_cos_secret_key
# Optional self-hosted-only fixed-target proxy endpoint.
# TENCENT_LIGHTCOS_PROXY_ENDPOINT=http://ses-proxy:8788/cos
# Leave blank until the published image domain is ready.
TENCENT_LIGHTCOS_PUBLIC_DOMAIN=

# Optional alternative provider.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_replace_with_your_api_key
# EMAIL_FROM=MemoscapeLab <noreply@example.com>

# --- 用户图片生成 API Key 的数据库加密主密钥 ---
# 平台不提供 IMAGE_PROVIDER 或任何厂商 API Key。每位用户在 /imagegen
# 填写自己的厂商、模型、地址和 API Key，配置按 user_id 独立保存。
# 此处只配置 base64 编码的 32 字节平台主密钥，用于 AES-GCM 加密用户密钥。
# 生成示例：openssl rand -base64 32
# 未配置时，平台会拒绝保存用户 API Key。
SETTINGS_ENCRYPTION_KEY=replace_with_base64_32_bytes
# 自托管 Worker 与固定目标代理之间的专用回调令牌（建议 32 字节随机 Base64）。
IMAGEGEN_INTERNAL_TOKEN=replace_with_random_internal_token

# --- 对外只读 API（/api/v1，供展示项目调用）---
# Bearer 密钥，仅项目列表校验 Authorization: Bearer <此值>；已发布单项目详情免密。生成示例：openssl rand -base64 32
READ_API_KEY=replace_with_a_long_random_read_key
# 允许的跨域来源（浏览器直调时必填），多个用英文逗号分隔；仅服务端调用可留空。
PUBLIC_API_ALLOWED_ORIGIN=https://display.example.com
